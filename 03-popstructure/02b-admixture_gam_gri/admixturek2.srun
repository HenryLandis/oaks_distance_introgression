#!/bin/bash
#SBATCH --job-name=admixture
#SBATCH --output=/data/lab/busch/henry/quercus/radseq/logs/out/%j_%x.out
#SBATCH --error=/data/lab/busch/henry/quercus/radseq/logs/err/%j_%x.err
#SBATCH --array=1-10
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=24:00:00
#SBATCH --mail-user=henry.landis@wsu.edu
#SBATCH --mail-type=ALL

admixture="/data/lab/busch/henry/quercus/radseq/03-popstructure/02a-admixture/admixture"
strseed=$(shuf -n 1 -i 0-2147483647)

$admixture -s $strseed --cv=10 -j4 ../01-pca/pca_075_gam_gri.bed 2 \
    > admixk2/struct_k2_${SLURM_ARRAY_TASK_ID}.out

mv pca_075_gam_gri.2.P admixk2/pca_075_gam_gri.2_${SLURM_ARRAY_TASK_ID}.P
mv pca_075_gam_gri.2.Q admixk2/pca_075_gam_gri.2_${SLURM_ARRAY_TASK_ID}.Q