#!/bin/bash
#SBATCH --job-name=vcf2phylip
#SBATCH --output=/data/lab/busch/henry/quercus/radseq/logs/out/%j_%x.out
#SBATCH --error=/data/lab/busch/henry/quercus/radseq/logs/err/%j_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=16G
#SBATCH --time=10:00:00
#SBATCH --mail-user=henry.landis@wsu.edu
#SBATCH --mail-type=ALL

# Default min samples per locus is 4.
python vcf2phylip/vcf2phylip.py \
    -i vcf_with_outgroups/genotypes_all_sites_variant_retained_final2.vcf.gz \
    -o Reference \
    --output-folder phylip_files

# Version to keep all sites even if they appear in only 1-3 samples.
python vcf2phylip/vcf2phylip.py \
    -i vcf_with_outgroups/genotypes_all_sites_variant_retained_final2.vcf.gz\
    -o Reference \
    -m 1 \
    --output-folder phylip_files