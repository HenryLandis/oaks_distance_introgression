#!/bin/bash
#SBATCH --job-name=ldecay
#SBATCH --output=/data/lab/busch/henry/quercus/radseq/logs/out/%j_%x.out
#SBATCH --error=/data/lab/busch/henry/quercus/radseq/logs/err/%j_%x.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=100G
#SBATCH --time=10:00:00
#SBATCH --mail-user=henry.landis@wsu.edu
#SBATCH --mail-type=ALL

module load r/4.5.1
module load htslib

bgzip -d ../01-python/genotypes_all_sites_variant_retained_final2.vcf.gz
./PopLDdecay/bin/PopLDdecay -InVCF ../01-python/genotypes_all_sites_variant_retained_final2.vcf -OutStat LDdecay
perl ./PopLDdecay/bin/Plot_OnePop.pl -inFile LDdecay.stat.gz -output Fig
bgzip ../01-python/genotypes_all_sites_variant_retained_final2.vcf